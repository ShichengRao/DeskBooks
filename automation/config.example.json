{
  "stagingDir": "~/Library/Application Support/DeskBooks/import-staging",
  "sources": [
    {
      "name": "plaid_mybank",
      "enabled": false,
      "module": "./fetchers/plaid.mjs",
      "environment": "sandbox",
      "clientIdPath": "~/.config/deskbooks/plaid/client-id",
      "secretPath": "~/.config/deskbooks/plaid/secret",
      "accessTokenPath": "~/.config/deskbooks/plaid/access-token-mybank",
      "lookbackDays": 90,
      "invertAmounts": false,
      "accounts": [
        { "plaidAccountId": "acc_example", "deskbooksAccountId": 1 }
      ]
    },
    {
      "name": "example_json_connector",
      "enabled": false,
      "module": "./fetchers/example-json-connector.mjs",
      "fixturePath": "./tests/fixtures/example-bundle.json"
    }
  ]
}
