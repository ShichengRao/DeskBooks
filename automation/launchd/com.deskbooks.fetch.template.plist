<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.deskbooks.fetch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/DeskBooks/automation/bin/run-scheduled-fetch.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>DESKBOOKS_FETCH_CONFIG</key>
    <string>/ABSOLUTE/PATH/TO/DeskBooks/automation/config.local.json</string>
    <key>DESKBOOKS_IMPORT_APPLY</key>
    <string>0</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/deskbooks-fetch.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/deskbooks-fetch.err.log</string>
</dict>
</plist>
